APP_HOST=127.0.0.1
APP_PORT=8001
API_KEY=local-dev-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=./data
MOSS_MODEL_ID=OpenMOSS-Team/MOSS-TTS-Local-Transformer-v1.5
# Set MOSS_MODEL_ID=./models/moss-tts-local-v1.5 after downloading
MOSS_DEVICE=auto
MOSS_MAX_NEW_TOKENS=4096
MAX_UPLOAD_MB=30

# Optional actual streaming: run SGLang-Omni model server separately
SGLANG_BASE_URL=

# Independent F5-TTS-THAI child-process Python executable (separate venv recommended)
F5_PYTHON=
F5_TIMEOUT_SECONDS=600

# Chatterbox-Turbo (English, separate Python 3.11 venv, resident worker)
CHATTERBOX_PYTHON=
CHATTERBOX_DEVICE=auto
CHATTERBOX_TIMEOUT_SECONDS=300

# Progressive sentence streaming with Chatterbox-Turbo requires no SGLang.
# Chatterbox-Turbo is English-only; native generate() returns completed waveforms.
CHATTERBOX_TEMPERATURE=0.8
CHATTERBOX_TOP_P=0.95
CHATTERBOX_TOP_K=1000
